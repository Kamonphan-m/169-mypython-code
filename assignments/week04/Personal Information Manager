def personal_info_manager():
    # 1. Initialize person tuple and hobbies list
    # (tuple format: name, age, city, country)
    person = ("Alice", 25, "New York", "USA")
    hobbies = ["Reading", "Traveling"]

    while True:
        print("\n=== Personal Information Manager ===")
        print("1. Display all information")
        print("2. Add new hobby")
        print("3. Remove hobby")
        print("4. Update age")
        print("5. Exit")

        choice = input("Enter your choice (1-5): ").strip()

        if choice == "1":
            # Display all stored information
            name, age, city, country = person
            print("\n--- Personal Details ---")
            print(f"Name: {name}")
            print(f"Age: {age}")
            print(f"City: {city}")
            print(f"Country: {country}")
            print(f"Hobbies: {', '.join(hobbies) if hobbies else 'None'}")

        elif choice == "2":
            # Add a new hobby
            new_hobby = input("Enter new hobby to add: ").strip()
            if new_hobby:
                hobbies.append(new_hobby)
                print(f"Successfully added '{new_hobby}'!")

        elif choice == "3":
            # Remove an existing hobby
            if not hobbies:
                print("No hobbies to remove.")
            else:
                hobby_to_remove = input("Enter hobby to remove: ").strip()
                if hobby_to_remove in hobbies:
                    hobbies.remove(hobby_to_remove)
                    print(f"Successfully removed '{hobby_to_remove}'!")
                else:
                    print(f"'{hobby_to_remove}' is not in the hobbies list.")

        elif choice == "4":
            # Update age by creating a NEW tuple (Tuples are immutable)
            try:
                new_age = int(input("Enter new age: "))
                person = (person[0], new_age, person[2], person[3])
                print(f"Age updated to {new_age} successfully!")
            except ValueError:
                print("Error: Please enter a valid integer for age.")

        elif choice == "5":
            print("Exiting program. Goodbye!")
            break

        else:
            print("Invalid option! Please select a choice between 1 and 5.")


if __name__ == "__main__":
    personal_info_manager()